{
  "expo": {
    "name": "靈犀",
    "slug": "lingxi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "lingxi",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#08080f"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.youquan.lingxi",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "靈犀需要使用相機進行面相分析",
        "NSLocationWhenInUseUsageDescription": "靈犀需要您的位置來提供即時風水分析",
        "NSMotionUsageDescription": "靈犀需要使用指南針來判斷方位",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#08080f"
      },
      "package": "com.yourname.lingxi",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-camera",
      "expo-location",
      "expo-sensors",
      "expo-notifications",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "22a8b11d-c07c-44df-b785-59a347afde18"
      }
    },
    "owner": "dennysu",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/22a8b11d-c07c-44df-b785-59a347afde18"
    }
  }
}
